# Copy this file to keys.env and fill in your own values. keys.env is NOT committed.
DB-DRIVER=com.mysql.cj.jdbc.Driver
DB-URL=jdbc:mysql://localhost:3306/restaurant
DB-USERNAME=
DB-PASSWORD=

CACHE-HOST=localhost
CACHE-PORT=6379

# Base64 string of at least 32 random bytes:  openssl rand -base64 32
JWT-SECRET-KEY=
# milliseconds, e.g. 3600000 = 1 hour
JWT-EXPIRATION=3600000

# Optional: an admin is created (or promoted) at startup when both are set
ADMIN-EMAIL=
ADMIN-PASSWORD=

# Optional, dev profile only: DDL-AUTO=create wipes and rebuilds the tables once (default: update)
# DDL-AUTO=create
