# Settings for docker-compose.yml.
# Copy this file to .env (git-ignored) and choose your own passwords.
# DB-USERNAME / DB-PASSWORD in keys.env must be the same as MYSQL_USER / MYSQL_PASSWORD here.

MYSQL_DATABASE=restaurant
MYSQL_USER=restaurant
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Ports on YOUR computer (inside Docker they are always 3306 and 6379).
# 3307 for MySQL so it never clashes with a MySQL installed on Windows.
MYSQL_PORT=3307
REDIS_PORT=6379
