# The ONE settings file of the project. Copy this file to .env (git-ignored: it holds passwords and the JWT key).
# Docker Compose reads it automatically. The API reads environment variables, so load this file as shown in
# the README ("Run it"). Names with a hyphen are for the API only: Docker Compose ignores them.

# ---- database --------------------------------------------------------------------------------------
# The login is written ONCE. Docker creates this MySQL user from it the first time the database is created,
# and the API logs in with it. Letters and digits only: other characters behave differently per tool.
SPRING_DATASOURCE_USERNAME=restaurant
SPRING_DATASOURCE_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
MYSQL_DATABASE=restaurant
# API only: where MySQL is for the API (3307 = MYSQL_PORT below)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3307/restaurant

# ---- ports on YOUR computer (inside Docker they are always 3306 and 6379) ----------------------------
# 3307 for MySQL so it never clashes with a MySQL installed on Windows.
MYSQL_PORT=3307
REDIS_PORT=6379

# ---- API -------------------------------------------------------------------------------------------
# Base64 string of at least 32 random bytes:  openssl rand -base64 48
JWT-SECRET-KEY=
# milliseconds, e.g. 3600000 = 1 hour
JWT-EXPIRATION=3600000

# Optional: an admin is created (or promoted) at startup when both are set
ADMIN-EMAIL=
ADMIN-PASSWORD=

# Optional, dev profile only: DDL-AUTO=create wipes and rebuilds the tables once (default: update)
# DDL-AUTO=create

# Browser frontends allowed to call the API, comma separated (required in prod if you have a web frontend)
# CORS-ALLOWED-ORIGINS=https://my-restaurant.example.com
